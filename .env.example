# Copy to .env (git-ignored) and fill in. Site-specific values live here, never in git.
# (Renamed from RAVE_* in the Sektor5 rebrand; the old RAVE_* names still work.)

# Wi-Fi the rig joins (used by brain/provision/make_cloudinit.py and fixtures/tubes/scripts/wled_wifi_serial.py)
S5_WIFI_SSID=
S5_WIFI_PASSWORD=
S5_WIFI_COUNTRY=AU
# More networks the brain should know (it joins whichever is in range), e.g. home:
# S5_WIFI2_SSID=
# S5_WIFI2_PASSWORD=

# Brain hostname when flashing a new one (brain/provision/make_cloudinit.py)
# S5_HOSTNAME=sektor5

# Hosts (defaults shown; only set these if a device isn't reachable by its .local name)
S5_BRAIN_HOST=sektor5.local
S5_BOX_HOST=rave-box.local
S5_TUBE1_HOST=rave-tube-1.local
S5_TUBE2_HOST=rave-tube-2.local
S5_MASK_HOST=s5-mask.local
# S5_PYRAMID_L_HOST=rave-pyramid-l.local   # the leg pyramids (docs/fixtures/leg-pyramids.md)
# S5_PYRAMID_R_HOST=rave-pyramid-r.local

# Running the show on a Mac against the real rig (./run.sh, brain/tools/mac_rig_ethernet.sh)
# S5_ROUTER_IP=        # the rig router
# S5_MAC_RIG_IP=       # this Mac's fixed address on the rig network (a free one in the router's subnet)
# S5_RIG_BOX_HOST=     # the panel box, if it's on the rig (else no panel)
