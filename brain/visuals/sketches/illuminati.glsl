  if (m < 1.5) { if (k < 0.5) return 62024.0; if (k < 1.5) return 782.0; if (k < 2.5) return 13001.0; if (k < 3.5) return 49161.0; if (k < 4.5) return 24708.0; if (k < 5.5) return 58057.0; if (k < 6.5) return 7.0; return 0.0; }   // NOVUS ORDO SECLORUM
  if (m < 2.5) { if (k < 0.5) return 8391.0; if (k < 1.5) return 65922.0; if (k < 2.5) return 21456.0; return 0.0; }   // MDCCLXXVI
