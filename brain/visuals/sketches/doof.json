      {"id": "every",  "label": "Turn to the next every (bars)", "min": 1, "max": 16, "step": 1, "default": 4},
      {"id": "size",   "label": "Size",                        "min": 0.6, "max": 1.4, "step": 0.01, "default": 1},
      {"id": "cy",     "label": "Height",                      "min": -0.15, "max": 0.15, "step": 0.005, "default": 0},
      {"id": "text",   "label": "DINKI DELL doof",             "min": 0, "max": 1, "step": 1, "default": 1, "kind": "fixed"}
    ]},
    {"name": "Motion", "params": [
      {"id": "hop",    "label": "Letters hop in turn",         "min": 0, "max": 1.5, "step": 0.01, "default": 0.8},
      {"id": "spin",   "label": "Turn (per 64 beats)",         "min": -2, "max": 2, "step": 0.01, "default": 0.5, "kind": "rate"},
      {"id": "beat",   "label": "Beat punch",                  "min": 0, "max": 1, "step": 0.01, "default": 0.7},
